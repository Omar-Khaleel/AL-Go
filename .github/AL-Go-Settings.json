{
  "type": "PTE",
  "templateUrl": "https://github.com/microsoft/AL-Go-PTE@v9.1",
  "projects": [
    "."
  ],
  "appFolders": [
    "app"
  ],
  "buildModes": [
    "Default"
  ],
  "environments": [
    "ProductionProof"
  ],
  "DeployToProductionProof": {
    "EnvironmentType": "ProductionProof",
    "EnvironmentName": "Sandbox",
    "Scope": "Dev",
    "continuousDeployment": false,
    "Branches": [
      "research/algo-two-account-pr-prod"
    ],
    "Projects": "*",
    "runs-on": "windows-latest",
    "shell": "powershell",
    "DependencyInstallMode": "ignore"
  }
}
